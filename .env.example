# Password Alain uses to open the wall at /host. Pick something only he (and you) know.
HOST_PASSWORD=change-me

# Optional: a code friends must type to submit (share it in the group chat). Leave empty for none.
SUBMIT_CODE=

# Optional: long random string for signing Alain's login cookie (defaults to one derived from HOST_PASSWORD).
SESSION_SECRET=

# Set automatically on Vercel when you connect a Blob store. Without it, data is kept on disk in ./data.
BLOB_READ_WRITE_TOKEN=
# Only if you created a *public* Blob store instead of a private one:
# BLOB_ACCESS=public
